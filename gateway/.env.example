PORT=8080
CORE_URL=http://127.0.0.1:8001
INSIGHTS_URL=http://127.0.0.1:8002
# Exact origin(s) of the React app, comma-separated (Vercel domain in production)
CORS_ALLOWED_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MIN=120
# Number of proxies in front of the gateway (0 locally, 1 on Railway) so rate limits use the real client IP
TRUST_PROXY=0
