{
  "name": "opendoor-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "OpenDoor API Gateway: single entry point that routes /api/* to Core and /api/insights/* to the Insights Service.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint ."
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "http-proxy-middleware": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
