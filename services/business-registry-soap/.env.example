PORT=8003
# WS-Security UsernameToken accepted by the registry (same values as REGISTRY_SOAP_* in core-api)
REGISTRY_SOAP_USER=opendoor-core
REGISTRY_SOAP_PASSWORD=
# Optional: SQLite file (default data/registry.db) and a fixed soap:address for the WSDL
# REGISTRY_DB_PATH=
# REGISTRY_PUBLIC_URL=http://registry.railway.internal:8003/soap
