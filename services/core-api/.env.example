APP_NAME=OpenDoor
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=opendoor_core
DB_USERNAME=opendoor_core
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Shared secret for Insights -> Core /internal/* calls
SERVICE_KEY_INSIGHTS=

# Legacy SOAP Business Registry
REGISTRY_WSDL_URL=http://localhost:8003/soap?wsdl
REGISTRY_SOAP_USER=opendoor-core
REGISTRY_SOAP_PASSWORD=
REGISTRY_TIMEOUT=5

# Password for seeded demo accounts (never hard-coded in seeders)
DEMO_PASSWORD=

# Public API base URL as the browser sees it (the gateway); used to build file links
PUBLIC_API_URL=http://localhost:8080/api
