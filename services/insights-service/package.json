{
  "name": "opendoor-insights-service",
  "version": "1.0.0",
  "private": true,
  "description": "OpenDoor Accessibility Insights Service: PSGC location lists and the Workplace Accessibility Snapshot mashup (Core + PSGC + Nominatim + Overpass).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint .",
    "build:psgc-fallback": "node scripts/build-psgc-fallback.mjs"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  },
  "dependencies": {
    "axios": "^1.20.0",
    "express": "^4.22.3",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nock": "^14.0.17",
    "supertest": "^7.3.1"
  }
}
